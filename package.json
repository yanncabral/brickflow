{
  "name": "brickflow-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "changeset": "changeset",
    "clean": "rm -rf packages/*/dist examples/*/dist coverage",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "package:check": "bash scripts/check-package.sh",
    "prepare": "husky",
    "release": "bun run build && changeset publish",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "validate": "bun run build && bun run typecheck && bun test && bun run lint && bun run package:check",
    "version-packages": "changeset version && bun install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.3.10",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
